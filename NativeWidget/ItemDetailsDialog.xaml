<Window x:Class="NativeWidget.ItemDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" MinWidth="340" MaxWidth="620" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#FA131217" CornerRadius="18" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MetadataText" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#401F1E25" CornerRadius="10" Padding="10" MaxHeight="330">
                    <Grid>
                        <RichTextBox x:Name="DescriptionView" Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="#E9E8ED" FontSize="12.5" IsReadOnly="True" IsDocumentEnabled="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        <TextBox x:Name="DescriptionEditor" Visibility="Collapsed" Style="{StaticResource InputStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="300"
                                 VerticalScrollBarVisibility="Auto" Padding="8"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock x:Name="SaveError" Grid.Row="2" Visibility="Collapsed" Foreground="#E5605A"
                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="EditButton" Content="Edit description" Click="EditButton_Click"
                            Style="{StaticResource SecondaryBtnStyle}" Visibility="Collapsed"/>
                    <Button x:Name="ExternalButton" Click="ExternalButton_Click"
                            Style="{StaticResource SecondaryBtnStyle}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelEditButton" Content="Cancel" Click="CancelEditButton_Click"
                            Style="{StaticResource SecondaryBtnStyle}" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"
                            Style="{StaticResource PrimaryBtnStyle}" MinWidth="72"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
