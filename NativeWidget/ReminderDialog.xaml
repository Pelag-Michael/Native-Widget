<Window x:Class="NativeWidget.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F2131217" CornerRadius="16" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Text="Set reminder" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="ExistingHint" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DaysInput" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,4,0"
                         Text="0" TextAlignment="Center" PreviewTextInput="Digits_PreviewTextInput" ToolTip="Days"/>
                <TextBox x:Name="HoursInput" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,0,4,0"
                         Text="0" TextAlignment="Center" PreviewTextInput="Digits_PreviewTextInput" ToolTip="Hours"/>
                <TextBox x:Name="MinsInput" Grid.Column="2" Style="{StaticResource InputStyle}"
                         Text="30" TextAlignment="Center" PreviewTextInput="Digits_PreviewTextInput" ToolTip="Minutes"/>
            </Grid>
            <TextBlock Text="days · hours · minutes from now" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="ClearBtn" Content="Clear reminder" Click="Clear_Click" Style="{StaticResource DangerBtnStyle}" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryBtnStyle}" Width="60" Margin="0,0,8,0"/>
                <Button Content="Set" Click="Ok_Click" Style="{StaticResource PrimaryBtnStyle}" Width="60"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
