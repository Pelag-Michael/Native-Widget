<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Authors>Pelag Michael</Authors>
    <Description>Native, low-RAM Windows widget dock built with WPF and .NET 8.</Description>
    <RepositoryUrl>https://github.com/Pelag-Michael/Native-Widget</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon only embeds the icon into the exe; it does not place a loose
         icon.ico next to it. A Start Menu shortcut was once created pointing its
         IconLocation at app\icon.ico, which a later publish silently wiped (publish
         cleans the output dir), leaving the shortcut showing the generic file icon.
         Shortcuts should point at the exe itself, but shipping the file too keeps a
         shared app/ folder self-contained and any older shortcut resolvable. -->
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NativeWidget.CalendarNetworkTests" />
  </ItemGroup>

</Project>
