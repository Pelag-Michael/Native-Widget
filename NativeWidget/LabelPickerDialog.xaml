<Window x:Class="NativeWidget.LabelPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260" SizeToContent="Height" MaxHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F2131217" CornerRadius="16" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Gắn nhãn" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="&#xE710;" ToolTip="Tạo nhãn mới" Click="AddLabel_Click" Style="{StaticResource IconBtnStyle}"/>
            </Grid>
            <TextBlock x:Name="EmptyHint" Text="Chưa có nhãn. Bấm + để tạo." Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" Visibility="Collapsed"/>
            <ListBox x:Name="LabelsList" MaxHeight="250" Background="Transparent" BorderThickness="0"
                     ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource ListItemStyle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Huỷ" Click="Cancel_Click" Style="{StaticResource SecondaryBtnStyle}" Width="70" Margin="0,0,8,0"/>
                <Button Content="Lưu" Click="Save_Click" Style="{StaticResource PrimaryBtnStyle}" Width="70"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
