<Window x:Class="NativeWidget.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NativeWidget"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Translate" Width="390" Height="64" MinWidth="330" MinHeight="58"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Left="540" Top="90" Closing="Window_Closing"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style x:Key="TrackingToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="#36353D" CornerRadius="11" BorderBrush="#484750" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3" Fill="#C7C6CD" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#497CFF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#5D8BFF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource PanelBg}" CornerRadius="18" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" Padding="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="DragBar_MouseDown" Cursor="SizeAll" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Translate" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <local:WidgetHeaderControls x:Name="HeaderControls" Grid.Column="1"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource ChipBg}" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceLanguageSelect" Padding="7,5" SelectionChanged="LanguageSelect_Changed"/>
                        <Button Grid.Column="1" Content="&#xE8AB;" FontFamily="Segoe MDL2 Assets" ToolTip="Đảo ngôn ngữ"
                                Click="SwapLanguages_Click" Style="{StaticResource IconBtnStyle}" Margin="3,0"/>
                        <ComboBox x:Name="TargetLanguageSelect" Grid.Column="2" Padding="7,5" SelectionChanged="LanguageSelect_Changed"/>
                    </Grid>
                    <Grid Margin="1,9,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tự dịch vùng chọn" Foreground="White" FontSize="11.5"/>
                            <TextBlock x:Name="TrackingState" Foreground="#8FE0A8" FontSize="9.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="TrackingCheck" Grid.Column="1" Click="TrackingCheck_Click"
                                      Style="{StaticResource TrackingToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Kéo bôi đen chữ ở ứng dụng khác để dịch."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="1,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="ManualTextInput" Style="{StaticResource InputStyle}" Height="52" Padding="9,7"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Nhập hoặc dán văn bản để dịch..." Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5" Margin="9,8,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ManualTextInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" ToolTip="Dịch văn bản đã nhập"
                        Click="TranslateManual_Click" Style="{StaticResource PrimaryBtnStyle}" Width="40" Height="40"
                        VerticalAlignment="Center" Margin="7,0,0,0"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Click="TranslateClipboard_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,4,0" Padding="9,6">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="Dịch clipboard"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Click="CaptureScreen_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="4,0,0,0" Padding="9,6">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="Chụp vùng màn hình"/></StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="TranslateStatus" Grid.Row="4" Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                       Text="Sẵn sàng" TextWrapping="Wrap" Margin="2,0,2,10"/>

            <Grid Grid.Row="5" Margin="0,1,0,8" Cursor="Hand" MouseLeftButtonUp="VocabularyHeader_Click">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="VocabularyChevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBlock x:Name="VocabularyTitle" Grid.Column="1" Text="SỔ TỪ VỰNG" Foreground="#7FA8FF"
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="VocabularyOpenHint" Grid.Column="2" Text="Mở" Foreground="{StaticResource MutedBrush}"
                           FontSize="9.5" VerticalAlignment="Center" Margin="8,0,2,0"/>
            </Grid>

            <Grid x:Name="VocabularySection" Grid.Row="6" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="VocabularySearch" Style="{StaticResource InputStyle}" Padding="9,6" TextChanged="VocabularySearch_TextChanged"/>
                        <TextBlock Text="Tìm từ hoặc bản dịch..." Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=VocabularySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="FilterToggle" Grid.Column="1" Content="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Lọc metadata" Click="FilterToggle_Click" Style="{StaticResource IconBtnStyle}" Margin="7,0,0,0"/>
                </Grid>

                <Border x:Name="MetadataFilterPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource ChipBg}"
                        CornerRadius="11" Padding="8" Margin="0,0,0,7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="LanguagePairFilter" Padding="7,5" Margin="0,0,4,4" SelectionChanged="MetadataFilter_Changed"/>
                        <ComboBox x:Name="CaptureMethodFilter" Grid.Column="1" Padding="7,5" Margin="4,0,0,4" SelectionChanged="MetadataFilter_Changed"/>
                        <ComboBox x:Name="SourceAppFilter" Grid.Row="1" Padding="7,5" Margin="0,4,4,0" SelectionChanged="MetadataFilter_Changed"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="4,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="VocabularyTagFilter" Padding="7,5" SelectionChanged="MetadataFilter_Changed"/>
                            <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" ToolTip="Tạo tag từ vựng"
                                    Click="CreateVocabularyTag_Click" Style="{StaticResource IconBtnStyle}" Margin="4,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="EmptyVocabulary" Text="Chưa có mục phù hợp." Foreground="{StaticResource MutedBrush}"
                               FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ListBox x:Name="VocabularyList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.IsVirtualizing="False" ItemContainerStyle="{StaticResource ListItemStyle}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
