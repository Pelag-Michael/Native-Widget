<Window x:Class="NativeWidget.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F2131217" CornerRadius="16" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="Dự án mới" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Tên dự án" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NameInput" Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

            <TextBlock Text="Folder (không bắt buộc)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderInput" Style="{StaticResource InputStyle}" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="..." Padding="10,7" FontWeight="Bold"
                        Click="Browse_Click" Style="{StaticResource SecondaryBtnStyle}"/>
            </Grid>

            <TextBlock Text="Ghi chú ngắn (không bắt buộc)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NoteInput" Style="{StaticResource InputStyle}" Margin="0,0,0,4"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Huỷ" Click="Cancel_Click" Style="{StaticResource SecondaryBtnStyle}" Width="70" Margin="0,0,8,0"/>
                <Button Content="Lưu" Click="Ok_Click" Style="{StaticResource PrimaryBtnStyle}" Width="70"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
