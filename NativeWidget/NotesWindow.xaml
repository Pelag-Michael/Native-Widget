<Window x:Class="NativeWidget.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NativeWidget"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Notes" Width="320" Height="460" MinWidth="240" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Left="90" Top="480" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource PanelBg}" CornerRadius="18" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="DragBar_MouseDown" Cursor="SizeAll" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Content="&#xE72B;" Click="Back_Click" Style="{StaticResource IconBtnStyle}" Margin="-6,0,4,0" Visibility="Collapsed"/>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Notes" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="NewNoteBtn" Content="&#xE710;" ToolTip="Ghi chú mới" Click="NewNote_Click" Style="{StaticResource IconBtnStyle}"/>
                    <local:WidgetHeaderControls x:Name="HeaderControls"/>
                </StackPanel>
            </Grid>

            <!-- LIST OF NOTES -->
            <Grid x:Name="ListPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputStyle}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Tìm ghi chú..." Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="ProjectFilter" Grid.Column="1" ToolTip="Lọc theo dự án" SelectionChanged="ProjectFilter_Changed"/>
                </Grid>
                <ComboBox x:Name="TagFilter" Grid.Row="1" Margin="0,0,0,8" ToolTip="Lọc theo nhãn" SelectionChanged="TagFilter_Changed"/>
                <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="Chưa có ghi chú nào. Bấm + để tạo." Foreground="{StaticResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <ListBox x:Name="NotesList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         ItemContainerStyle="{StaticResource ListItemStyle}" MouseUp="NotesList_MouseUp"/>
            </Grid>

            <!-- EDITOR -->
            <Grid x:Name="EditorPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource ChipBg}" CornerRadius="10" Padding="4" Margin="0,0,0,8">
                    <WrapPanel>
                        <ComboBox x:Name="FontFamilyCombo" Width="98" Margin="0,0,4,0" SelectionChanged="FontFamilyCombo_Changed">
                            <ComboBoxItem Content="Có chân" Tag="Georgia"/>
                            <ComboBoxItem Content="Không chân" Tag="Segoe UI" IsSelected="True"/>
                            <ComboBoxItem Content="Mono/Code" Tag="Consolas"/>
                        </ComboBox>
                        <ComboBox x:Name="FontSizeCombo" Width="52" Margin="0,0,8,0" SelectionChanged="FontSizeCombo_Changed">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="12" IsSelected="True"/>
                            <ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="18"/>
                            <ComboBoxItem Content="22"/>
                        </ComboBox>
                        <Button x:Name="BoldBtn" Content="B" FontWeight="Bold" Click="Bold_Click" Style="{StaticResource IconBtnStyle}" FontFamily="Segoe UI" Width="24"/>
                        <Button x:Name="ItalicBtn" Content="I" FontStyle="Italic" Click="Italic_Click" Style="{StaticResource IconBtnStyle}" FontFamily="Segoe UI" Width="24"/>
                        <Button x:Name="StrikeBtn" Content="S" Click="Strike_Click" Style="{StaticResource IconBtnStyle}" FontFamily="Segoe UI" Width="24">
                            <Button.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="H1" ToolTip="Tiêu đề (Ctrl+Alt+1)" Click="Heading1_Click" Style="{StaticResource IconBtnStyle}" FontFamily="Segoe UI" FontWeight="Bold" Width="28"/>
                        <Button Content="H2" ToolTip="Tiêu đề phụ (Ctrl+Alt+2)" Click="Heading2_Click" Style="{StaticResource IconBtnStyle}" FontFamily="Segoe UI" FontWeight="Bold" Width="28"/>
                        <Button Content="&#xE8FD;" ToolTip="Danh sách chấm (Ctrl+Shift+8)" Click="BulletList_Click" Style="{StaticResource IconBtnStyle}" Width="26"/>
                        <Button Content="&#xE8EF;" ToolTip="Danh sách số (Ctrl+Shift+7)" Click="NumberList_Click" Style="{StaticResource IconBtnStyle}" Width="26"/>
                        <Button Content="&#xE73A;" ToolTip="Việc cần làm (Ctrl+Shift+9)" Click="Todo_Click" Style="{StaticResource IconBtnStyle}" Width="26"/>
                        <Button Content="&#xE90A;" ToolTip="Trích dẫn (Ctrl+Shift+Q)" Click="Quote_Click" Style="{StaticResource IconBtnStyle}" Width="26"/>
                        <Button Content="&lt;/&gt;" ToolTip="Khối mã (Ctrl+Shift+C)" Click="Code_Click" Style="{StaticResource IconBtnStyle}" FontFamily="Consolas" FontSize="10" Width="32"/>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource ChipBg}" CornerRadius="12" Padding="8" Margin="0,0,0,10">
                    <RichTextBox x:Name="NoteText" Background="Transparent" Foreground="White" BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="12" CaretBrush="White"
                                 VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                                 PreviewKeyDown="NoteText_PreviewKeyDown"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PopOutBtn" Content="&#xE8A7;" ToolTip="Mở note này ra cửa sổ riêng" Click="PopOut_Click" Style="{StaticResource IconBtnStyle}" Margin="4,0"/>
                    <Button Content="&#xE8AC;" ToolTip="Đổi tên" Click="Rename_Click" Style="{StaticResource IconBtnStyle}" Margin="4,0"/>
                    <Button Content="&#xE74E;" ToolTip="Lưu" Click="Save_Click" Style="{StaticResource IconBtnStyle}" Margin="4,0"/>
                    <Button Content="&#xE8C8;" ToolTip="Copy" Click="Copy_Click" Style="{StaticResource IconBtnStyle}" Margin="4,0"/>
                    <Button Content="&#xE74D;" ToolTip="Xoá ghi chú này" Click="Delete_Click" Style="{StaticResource IconBtnStyle}" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
