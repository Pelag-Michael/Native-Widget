<Window x:Class="NativeWidget.TimeBudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F2131217" CornerRadius="16" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="New time budget" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Goal / Activity name" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NameInput" Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

            <TextBlock Text="Target hours per week" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HoursInput" Text="8" Style="{StaticResource InputStyle}" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="hours/week" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="4h" Click="Preset_Click" Tag="4" Style="{StaticResource SecondaryBtnStyle}" Padding="8,3" Margin="0,0,4,4"/>
                <Button Content="8h" Click="Preset_Click" Tag="8" Style="{StaticResource SecondaryBtnStyle}" Padding="8,3" Margin="0,0,4,4"/>
                <Button Content="10h" Click="Preset_Click" Tag="10" Style="{StaticResource SecondaryBtnStyle}" Padding="8,3" Margin="0,0,4,4"/>
                <Button Content="15h" Click="Preset_Click" Tag="15" Style="{StaticResource SecondaryBtnStyle}" Padding="8,3" Margin="0,0,4,4"/>
                <Button Content="20h" Click="Preset_Click" Tag="20" Style="{StaticResource SecondaryBtnStyle}" Padding="8,3" Margin="0,0,4,4"/>
                <Button Content="40h" Click="Preset_Click" Tag="40" Style="{StaticResource SecondaryBtnStyle}" Padding="8,3" Margin="0,0,4,4"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryBtnStyle}" Width="70" Margin="0,0,8,0"/>
                <Button Content="Save" Click="Ok_Click" Style="{StaticResource PrimaryBtnStyle}" Width="70"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
