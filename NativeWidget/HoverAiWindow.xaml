<Window x:Class="NativeWidget.HoverAiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NativeWidget"
        Title="Quick AI" Width="260" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Arrow" ForceCursor="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CopyHoverButton" TargetType="Button" BasedOn="{StaticResource SecondaryBtnStyle}">
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="HoverIcons" Color="#EEEEF2"/>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource HoverIcons}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource HoverIcons}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Chrome" MouseLeftButtonDown="Chrome_Drag" Background="#131217" CornerRadius="12" Padding="10" BorderBrush="#25FFFFFF" BorderThickness="1">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="Title_Drag" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <Button Content="&#xE722;" FontFamily="Segoe MDL2 Assets" Click="Capture_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TitleText" Visibility="Collapsed" Text="" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Ellipse x:Name="PasteDot" Width="5" Height="5" Fill="White" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Button x:Name="PasteButton" Grid.Column="1" Content="Paste" Click="Paste_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="8,4"/>
                <Button x:Name="CopyResponseButton" Grid.Column="2" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" Click="CopyResponse_Click" Style="{StaticResource CopyHoverButton}" Margin="4,0,0,0" Padding="5,3" FontSize="10"/>
                <Button x:Name="SendButton" Grid.Column="3" Content="&#x2191;" Click="Ask_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="4,0,0,0" Padding="7,3" FontSize="11"/>
                <Button Grid.Column="4" Content="+" Click="FollowUp_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="4,0,0,0" Padding="7,1" FontSize="11"/>
                <Button x:Name="ResetButton" Grid.Column="5" Content="&#xE777;" FontFamily="Segoe MDL2 Assets" Click="Clear_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="4,0,0,0" Padding="7,3" FontSize="11"/>
                <Button Grid.Column="6" Content="&#x22EF;" Click="Options_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="4,0,0,0" Padding="7,1" FontSize="11"/>
            </Grid>
            <Grid x:Name="FollowUpPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="QuestionInput" Style="{StaticResource InputStyle}" Padding="7,5" TextWrapping="Wrap" TextChanged="Question_Changed"
                         AcceptsReturn="True" MaxHeight="85" VerticalScrollBarVisibility="Auto"/>
                <Button Grid.Column="1" Content="&#x2191;" Click="Ask_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="5,0,0,0" Padding="9,4"/>
            </Grid>
            <StackPanel x:Name="ResponsePanel" Visibility="Collapsed" Margin="0,8,0,0">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock x:Name="ResponseLabel" Text="AI" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                    <Button Content="×" Click="CloseResponse_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="5,0" FontSize="10" HorizontalAlignment="Right"/>
                </DockPanel>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="AnswerText" Text="" TextWrapping="Wrap" Opacity="0.9"/>
                </ScrollViewer>
            </StackPanel>
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="AppearancePanel" Visibility="Collapsed" Margin="0,10,0,0">
                <CheckBox x:Name="QuickerCheck" Content="Quicker: copy and send" Click="Appearance_Changed" Margin="0,0,0,8"/>
                <TextBlock Text="Ctrl + Left copies the selection, adds it to input and sends." TextWrapping="Wrap" FontSize="10" Opacity="0.65" Margin="0,0,0,8"/>
                <TextBlock Text="Screenshot temp folder" FontSize="11"/>
                <TextBox x:Name="ScreenshotFolderInput" Style="{StaticResource InputStyle}" IsReadOnly="True" Padding="6,4" Margin="0,4,0,4"/>
                <Button Content="Choose temp folder..." Click="ScreenshotFolder_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="6,4" Margin="0,0,0,8"/>
                <CheckBox x:Name="EditLayoutCheck" Content="Edit layout" Click="EditLayout_Click" Margin="0,0,0,8"/>
                <TextBlock Text="Drag corners to resize; Shift + drag a corner to move." TextWrapping="Wrap" FontSize="10" Opacity="0.65" Margin="0,0,0,8"/>
                <CheckBox x:Name="CaptureRegionCheck" Content="Use fixed capture area" Click="Capture_Changed"/>
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <TextBox x:Name="CaptureX" Style="{StaticResource InputStyle}" Padding="6,4" Tag="X" TextChanged="Capture_Changed" Margin="0,0,3,3"/>
                    <TextBox x:Name="CaptureY" Style="{StaticResource InputStyle}" Padding="6,4" Tag="Y" TextChanged="Capture_Changed" Margin="3,0,0,3"/>
                    <TextBox x:Name="CaptureWidth" Style="{StaticResource InputStyle}" Padding="6,4" Tag="Width" TextChanged="Capture_Changed" Margin="0,0,3,3"/>
                    <TextBox x:Name="CaptureHeight" Style="{StaticResource InputStyle}" Padding="6,4" Tag="Height" TextChanged="Capture_Changed" Margin="3,0,0,3"/>
                </UniformGrid>
                <TextBlock Text="X / Y - Width / Height (pixels)" FontSize="10" Opacity="0.65"/>
                <Button Content="Choose capture area..." Click="ChooseCapture_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="0,5,0,10" Padding="6,5"/>
                <CheckBox x:Name="MinimalCheck" Content="Minimal" Foreground="White" IsChecked="True" Click="Appearance_Changed"/>
                <TextBlock Text="Input opacity" Foreground="#A8A8B2" FontSize="11" Margin="0,8,0,2"/>
                <Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1" Value="1" ValueChanged="Appearance_ValueChanged"/>
                <TextBlock Text="Dot opacity" FontSize="11" Margin="0,8,0,2"/>
                <Slider x:Name="StatusOpacitySlider" Minimum="0" Maximum="1" Value="1" ValueChanged="Appearance_ValueChanged"/>
                <TextBlock Text="AI response opacity" FontSize="11" Margin="0,8,0,2"/>
                <Slider x:Name="ResponseOpacitySlider" Minimum="0" Maximum="1" Value="1" ValueChanged="Appearance_ValueChanged"/>
                <CheckBox x:Name="TextOnlyCheck" Content="Response: text only" Click="Appearance_Changed" Margin="0,8,0,0"/>
                <CheckBox x:Name="AutoHeightCheck" Content="Auto height: show all text" Click="Appearance_Changed" Margin="0,6,0,0"/>
                <TextBlock Text="Width" Foreground="#A8A8B2" FontSize="11" Margin="0,8,0,2"/>
                <Slider x:Name="WidthSlider" Minimum="180" Maximum="600" Value="260" ValueChanged="Appearance_ValueChanged"/>
                <TextBlock Text="Text size" Foreground="#A8A8B2" FontSize="11" Margin="0,8,0,2"/>
                <Slider x:Name="FontSlider" Minimum="9" Maximum="20" Value="12" ValueChanged="Appearance_ValueChanged"/>
                <UniformGrid Columns="3" Margin="0,10,0,6">
                    <Button Content="Panel" Tag="Panel" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10"/>
                    <Button Content="Text" Tag="Text" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10" Margin="4,0"/>
                    <Button Content="Icons" Tag="Icons" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Button Content="Dot" Tag="Dot" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10" Margin="0,0,2,4"/>
                    <Button Content="Dot panel" Tag="Dot panel" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10" Margin="2,0,0,4"/>
                    <Button Content="AI panel" Tag="AI panel" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10" Margin="0,0,2,0"/>
                    <Button Content="AI text" Tag="AI text" Click="ColorTarget_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="4,5" FontSize="10" Margin="2,0,0,0"/>
                </UniformGrid>
                <TextBlock x:Name="ColorTargetLabel" Text="Panel color" FontSize="11" HorizontalAlignment="Center"/>
                <local:ColorWheel x:Name="Wheel" HorizontalAlignment="Center"/>
                <TextBlock Text="Brightness" FontSize="11" Margin="0,4"/>
                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="1" ValueChanged="Brightness_Changed"/>
                <TextBox x:Name="BackgroundInput" Visibility="Collapsed"/>
                <TextBox x:Name="ForegroundInput" Visibility="Collapsed"/>
                <TextBlock x:Name="AppearanceError" Foreground="#FFAA99" TextWrapping="Wrap" FontSize="10"/>
                <WrapPanel Margin="0,7,0,0">
                    <Button Content="Demo AI" Click="Demo_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="8,4" FontSize="10"/>
                    <Button Content="Clear" Click="Clear_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="5,0,0,0" Padding="8,4" FontSize="10"/>
                    <Button Content="Settings" Click="Settings_Click" Style="{StaticResource SecondaryBtnStyle}" Margin="5,0,0,0" Padding="8,4" FontSize="10"/>
                </WrapPanel>
            </StackPanel></ScrollViewer>
        </StackPanel>
    </Border>
</Window>
