<Window x:Class="NativeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NativeWidget"
        Title="Widgets" Width="52" Height="52"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        Left="40" Top="40">
    <Grid Background="Transparent">
        <!-- The launcher itself stays compact. Its menu is a separate round Popup, so
             hovering no longer stretches a long horizontal bar across the desktop. -->
        <!-- Collapsed dock. Hidden while the radial menu is open so only one hub is visible;
             the menu scales up from this size so it reads as the same control expanding. -->
        <Border x:Name="RootBorder" Background="{StaticResource PanelBg}" CornerRadius="22"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8">
            <Border x:Name="DragBar" Cursor="SizeAll" MouseLeftButtonDown="DragBar_MouseDown"
                    Background="Transparent" ToolTip="Drag to move · hover to open menu">
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Border>

        <!-- Centered on the dock (not Placement=Bottom). Scale origin is the hub center. -->
        <Popup x:Name="LauncherPopup" PlacementTarget="{Binding ElementName=RootBorder}" Placement="Center"
               AllowsTransparency="True" StaysOpen="True">
            <Border x:Name="LauncherPopupContent" Width="232" Height="232" Background="#FA131217" CornerRadius="116"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    MouseEnter="LauncherPopup_MouseEnter" MouseLeave="LauncherPopup_MouseLeave"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <!-- Start scale ≈ dock/menu (52/232) so open feels like growth from the button. -->
                    <ScaleTransform ScaleX="0.224" ScaleY="0.224"/>
                </Border.RenderTransform>
                <Grid>
                    <local:RadialPanel Margin="8">
                        <Button x:Name="BtnSearch" Content="&#xE721;" Click="OpenSearch_Click" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnProjects" Content="&#xE8A5;" Click="ToggleWidget_Click" Tag="Projects" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnCalendar" Content="&#xE787;" Click="ToggleWidget_Click" MouseRightButtonUp="QuickAddCalendar_Click" Tag="Calendar" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnTasks" Content="&#xE73A;" Click="ToggleWidget_Click" MouseRightButtonUp="QuickAddTask_Click" Tag="Tasks" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnNotes" Content="&#xE70F;" Click="ToggleWidget_Click" MouseRightButtonUp="QuickAddNote_Click" Tag="Notes" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnTimers" Content="&#xE916;" Click="ToggleWidget_Click" Tag="Timers" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnFocus" Content="&#xE121;" Click="ToggleWidget_Click" Tag="Focus" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnTranslate" Content="&#xE774;" Click="ToggleWidget_Click" Tag="Translate" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnLabels" Content="&#xE8EC;" Click="ToggleWidget_Click" Tag="Labels" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnSettings" Content="&#xE713;" Click="ToggleWidget_Click" Tag="Settings" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                        <Button x:Name="BtnWindowTools" Content="&#xE7C4;" Click="WindowTools_Click" Style="{StaticResource TabIconStyle}" Width="38" Height="38"
                                MouseEnter="LauncherAction_MouseEnter" MouseLeave="LauncherAction_MouseLeave"/>
                    </local:RadialPanel>
                    <!-- Continuity hub: same 52px dock look, replaces RootBorder while open. -->
                    <Border x:Name="LauncherHub" Width="52" Height="52" Background="{StaticResource PanelBg}" CornerRadius="26"
                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cursor="SizeAll" MouseLeftButtonDown="DragBar_MouseDown"
                            ToolTip="Drag to move">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- Instant dark label that slides out beside the hovered launcher action. -->
        <Popup x:Name="LauncherHintPopup" Placement="Right" HorizontalOffset="10" VerticalOffset="0"
               AllowsTransparency="True" IsHitTestVisible="False" StaysOpen="True">
            <Border x:Name="LauncherHintChrome" Background="#F5131217" CornerRadius="11"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Padding="11,7" MinWidth="108" Opacity="0" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="-12"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="LauncherHintTitle" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LauncherHintShortcut" Foreground="{StaticResource AccentBrush}"
                               FontSize="10.5" Margin="0,2,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="LauncherHintExtra" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="180"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="WindowToolsPopup" Placement="MousePoint" HorizontalOffset="8" VerticalOffset="8"
               AllowsTransparency="True" StaysOpen="False" Closed="WindowToolsPopup_Closed">
            <Border x:Name="WindowToolsPanel" Width="218" Background="#FC131217" CornerRadius="15"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12"
                    MouseEnter="WindowToolsPanel_MouseEnter" MouseLeave="WindowToolsPanel_MouseLeave">
                <StackPanel>
                    <Grid Margin="1,0,1,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="WINDOWS" Foreground="#7FA8FF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GlobalWindowCount" Grid.Column="1" Foreground="{StaticResource MutedBrush}"
                                   FontSize="9.5" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="{StaticResource ChipBg}" CornerRadius="11" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="GlobalPinBtn" Content="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                    ToolTip="Pin / unpin all open widgets" Click="GlobalPin_Click"
                                    Style="{StaticResource IconBtnStyle}" Width="34" Height="34"/>
                            <Button x:Name="GlobalGhostBtn" Grid.Column="1" Content="&#xE890;" FontFamily="Segoe MDL2 Assets"
                                    ToolTip="Ghost / unghost all (Ctrl+Alt+G unghosts)" Click="GlobalGhost_Click"
                                    Style="{StaticResource IconBtnStyle}" Width="34" Height="34"/>
                            <Button x:Name="GlobalCloseBtn" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                    ToolTip="Close all open widgets" Click="GlobalCloseAll_Click"
                                    Style="{StaticResource IconBtnStyle}" Width="34" Height="34" Foreground="#D46B68"/>
                        </Grid>
                    </Border>

                    <Grid Margin="2,10,2,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="GlobalOpacitySlider" Grid.Column="1" Minimum="0.2" Maximum="1" Value="1"
                                SmallChange="0.05" LargeChange="0.1" ValueChanged="GlobalOpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="GlobalOpacityLabel" Grid.Column="2" Text="100%" Foreground="{StaticResource MutedBrush}"
                                   FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
