<Window x:Class="NativeWidget.ScreenRegionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#44000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="SelectionBorder" Visibility="Collapsed" BorderBrush="#7FA8FF"
                BorderThickness="2" Background="#16FFFFFF" CornerRadius="3"/>
        <Border Canvas.Left="18" Canvas.Top="18" Background="#E8131217" CornerRadius="10" Padding="10,6">
            <TextBlock Text="Drag to select text region · Esc to cancel" Foreground="White" FontSize="12"/>
        </Border>
    </Canvas>
</Window>
