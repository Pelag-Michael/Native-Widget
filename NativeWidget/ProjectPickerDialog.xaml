<Window x:Class="NativeWidget.ProjectPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="240" SizeToContent="Height" MaxHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F2131217" CornerRadius="16" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Text="Assign project" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox x:Name="ProjectListBox" MaxHeight="240" Background="Transparent" BorderThickness="0"
                     ScrollViewer.CanContentScroll="False" MouseUp="ProjectListBox_MouseUp"
                     ItemContainerStyle="{StaticResource ListItemStyle}"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryBtnStyle}" HorizontalAlignment="Right" Width="70" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
